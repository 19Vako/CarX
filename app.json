{
  "expo": {
    "name": "carX",
    "slug": "carX",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.sergii.carx",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#808080",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#808080"
    },
    "androidNavigationBar": {
      "visible": "leanback",
      "barStyle": "dark-content",
      "backgroundColor": "#808080"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sergii.carx",
      "icon": "./assets/images/favicon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.sergii.carx",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAeg73Geu1Tire1H5jwvkvx9tNNvQ-dOAk"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#808080"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#808080"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.745026637842-4dg63coer9d5gq78vr9frheeo08i6vp7"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "carx",
          "organization": "ggroup"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CarX wants to use your location in the background.",
          "locationAlwaysPermission": "CarX uses background location tracking to allow drivers to receive orders in the background",
          "locationWhenInUsePermission": "Allow access to geodata to display your location on the map.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.sergii.carx",
          "enableGooglePay": true
        }
      ],
      [
        "react-native-app-auth",
        {
          "redirectUrls": ["com.sergii.carx"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "appAuthRedirectScheme": "carx",
      "eas": {
        "projectId": "a5529b53-c9b2-4288-82da-0b7b0460e30f"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/a5529b53-c9b2-4288-82da-0b7b0460e30f"
    }
  }
}
